{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "site",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/*.py": {
      "includeFiles": "{memory,src/mempr}/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/pull-requests/:id",
      "destination": "/api/pull-requests?id=:id"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "playground/*": false
    }
  }
}
